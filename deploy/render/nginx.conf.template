worker_processes 1;
pid /tmp/fluxdb-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    # The public method/path map contains long API route keys.
    map_hash_bucket_size 128;
    map_hash_max_size 2048;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    client_body_temp_path /tmp/fluxdb-body;
    proxy_temp_path /tmp/fluxdb-proxy;
    fastcgi_temp_path /tmp/fluxdb-fastcgi;
    uwsgi_temp_path /tmp/fluxdb-uwsgi;
    scgi_temp_path /tmp/fluxdb-scgi;
    client_max_body_size 2m;
    limit_req_zone $server_name zone=api:1m rate=10r/s;
    limit_req_zone $server_name zone=ai:1m rate=6r/m;
    limit_req_status 429;
    map $http_authorization $admin {
        default 0;
        "Bearer __TOKEN__" 1;
    }
    map "$admin:$request_method:$uri" $allowed {
        default 0;
        ~^1: 1;
        ~^0:(GET|HEAD): 1;
        ~^0:POST:/api/v1/databases/[^/]+/query$ 1;
        "0:POST:/api/v1/assistant/chat" 1;
    }
    server {
        listen 0.0.0.0:__PORT__;
        server_name _;
        root /app/web;
        index index.html;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        error_page 403 = @readonly;
        error_page 429 = @limited;
        location @readonly {
            default_type application/json;
            return 403 '{"error":"Public demo is read-only. Connect with the administrator token to change data. All demo data is temporary."}';
        }
        location @limited {
            default_type application/json;
            return 429 '{"error":"Demo request limit reached. Wait a moment and retry; AI requests are limited to six per minute across the demo."}';
        }
        location = /api/v1/assistant/chat {
            if ($allowed = 0) { return 403; }
            limit_req zone=ai burst=2 nodelay;
            proxy_pass http://127.0.0.1:18086;
            proxy_set_header Authorization "Bearer __TOKEN__";
            proxy_read_timeout 120s;
        }
        location ~ ^/(api|write|query|metrics|health|ping|stats|databases)(/|$) {
            if ($allowed = 0) { return 403; }
            limit_req zone=api burst=30 nodelay;
            proxy_pass http://127.0.0.1:18086;
            proxy_set_header Authorization "Bearer __TOKEN__";
            proxy_read_timeout 120s;
        }
        location /assets/ { expires 1y; }
        location / { try_files $uri $uri/ /index.html; }
    }
}
