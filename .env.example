# Copy to .env and replace both secrets. Generate each with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Administration token for the single-tenant /api/v1 surface. That surface can
# name any engine database, so it sits underneath project isolation — it always
# needs a real secret, even when the console is the only thing you use.
FLUXDB_TOKEN=replace-with-at-least-32-random-characters

# Signs OAuth state and cookie values. Set it so sessions and in-flight sign-in
# round trips survive a restart.
FLUXDB_SESSION_SECRET=replace-with-at-least-32-random-characters

# Absolute base URL visitors reach. Used to build the OAuth callback and to
# decide whether cookies get the Secure attribute.
PUBLIC_BASE_URL=http://localhost:8080

# Control-plane metadata. Leave empty to keep accounts in a SQLite file beside
# the time-series data. Set a Postgres URL when the filesystem is ephemeral —
# a hosted container loses its disk on every redeploy, and with it every account.
#   DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# GitHub sign-in. Create an OAuth app with the callback
#   <PUBLIC_BASE_URL>/api/cloud/auth/github/callback
# Both values are required; the provider stays disabled if either is missing.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional server-side Gemini key for the AI assistant. Never put a provider key
# in a VITE_* variable — those are compiled into the browser bundle.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
