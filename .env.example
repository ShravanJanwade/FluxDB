FLUXDB_TOKEN=replace-with-at-least-32-random-characters
FLUXDB_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional server-side Gemini key. Never put this in VITE_* variables.
# Alternatively enter a memory-only session key in Ask AI > Settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
