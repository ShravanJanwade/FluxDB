    "/api/v1/assistant/config": {
      "get": {
        "summary": "Assistant configuration without credentials",
        "operationId": "assistant_config",
        "responses": {
          "200": {
            "description": "Provider, configured flag, default_model, execution limits; no secret values"
          },
          "401": {
            "description": "Invalid FluxDB bearer token"
          }
        }
      }
    },
    "/api/v1/assistant/chat": {
      "post": {
        "summary": "Run a bounded Gemini tool loop; mutations are proposals only",
        "operationId": "assistant_chat",
        "parameters": [
          {
            "name": "x-gemini-api-key",
            "in": "header",
            "required": false,
            "description": "Optional session provider key overriding GEMINI_API_KEY; never persisted",
            "schema": {
              "type": "string",
              "writeOnly": true
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "messages"
                ],
                "properties": {
                  "database": {
                    "type": "string"
                  },
                  "page": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "model": {
                    "type": "string",
                    "description": "Gemini model ID; defaults to GEMINI_MODEL"
                  },
                  "allow_read_data": {
                    "type": "boolean",
                    "default": false
                  },
                  "messages": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "required": [
                        "role",
                        "text"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "assistant"
                          ]
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 16000
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "database": "observability",
                "page": "Query workspace",
                "messages": [
                  {
                    "role": "user",
                    "text": "Inspect my schema and propose a query"
                  }
                ],
                "allow_read_data": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "reply, actions [{operation,database,payload,explanation}], steps [{tool,status,detail}], model. Actions must be explicitly executed using the existing database endpoints."
          },
          "400": {
            "description": "Invalid scope, history, or model"
          },
          "401": {
            "description": "Invalid FluxDB token"
          },
          "404": {
            "description": "Database missing"
          },
          "429": {
            "description": "Assistant concurrency or Gemini quota limit"
          },
          "502": {
            "description": "Provider connection, model, permissions, or response error"
          },
          "503": {
            "description": "No Gemini API key configured"
          },
          "504": {
            "description": "100-second turn deadline exceeded"
          }
        }
      }
    },
    "/api/v1/assistant/models": {
      "get": {
        "summary": "Check provider key and list Gemini generateContent model IDs",
        "operationId": "assistant_models",
        "parameters": [
          {
            "name": "x-gemini-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "writeOnly": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "models: array of {id, name}; availability does not guarantee function-calling support or quota"
          },
          "401": {
            "description": "Invalid FluxDB token"
          },
          "429": {
            "description": "Assistant busy"
          },
          "502": {
            "description": "Provider key, permissions, or network failure"
          },
          "503": {
            "description": "Gemini key not configured"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Point": {
        "type": "object",
        "required": [
          "measurement",
          "timestamp",
          "fields"
        ],
        "properties": {
          "measurement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "timestamp": {
            "type": "string",
            "pattern": "^-?[0-9]+$",
            "description": "Signed i64 Unix nanoseconds; never a JSON number"
          },
          "tags": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "required": [
                    "integer"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "integer": {
                      "type": "string",
                      "pattern": "^-?[0-9]+$"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
