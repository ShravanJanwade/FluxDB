              "schema": {
                "type": "object",
                "required": [
                  "points"
                ],
                "properties": {
                  "points": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10000,
                    "items": {
                      "$ref": "#/components/schemas/Point"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ]
      },
      "get": {
        "summary": "Read live points, newest first",
        "operationId": "get__api_v1_databases_name_points",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Database not found"
          },
          "413": {
            "description": "Body exceeds 2 MiB"
          },
          "422": {
            "description": "Invalid JSON shape"
          },
          "500": {
            "description": "Storage or internal error"
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          },
          {
            "name": "measurement",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Exact measurement filter"
          },
          {
            "name": "start",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Inclusive ns lower bound"
          },
          {
            "name": "end",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Inclusive ns upper bound"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Default 100, clamped to 1\u20131000"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Default 0"
          }
        ]
      },
      "delete": {
        "summary": "Permanently delete an inclusive time range",
        "operationId": "delete__api_v1_databases_name_points",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Database not found"
          },
          "413": {
            "description": "Body exceeds 2 MiB"
          },
          "422": {
            "description": "Invalid JSON shape"
          },
          "500": {
            "description": "Storage or internal error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "measurement",
                  "start",
                  "end"
                ],
                "properties": {
                  "measurement": {
                    "type": "string"
                  },
                  "start": {
                    "type": "string"
                  },
                  "end": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "exact": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ]
      }
    },
