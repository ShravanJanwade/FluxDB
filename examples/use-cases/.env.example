# Copy to .env.local for `npm run dev`. On Vercel, add the same names under
# Settings > Environment Variables.

# Where FluxDB answers, without a trailing slash. The hosted demo:
FLUXDB_URL=https://fluxdb.icygrass-95174406.westus2.azurecontainerapps.io

# A project API key with read and write scopes, from the FluxDB console
# (your project > API keys). It stays on the server: never prefix it with
# NEXT_PUBLIC_.
FLUXDB_API_KEY=fdbk_replace_me

# Bucket names, if yours differ from these defaults.
# FLUXDB_ENERGY_BUCKET=energy
# FLUXDB_VITALS_BUCKET=vitals
# FLUXDB_MARKETS_BUCKET=markets
